# PostgreSQL. Use a pooler URL for runtime; a direct connection for migrations if needed.
DATABASE_URL=
AUTH_SECRET=
# Auth.js v4 uses NEXTAUTH_*; AUTH_SECRET is mapped by the application.
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Account-wide upload quota. Default 200 MiB, independent of invitation count.
MAX_USER_STORAGE_BYTES=209715200
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=
SUPPORT_EMAIL=
CRON_SECRET=
# Off unless explicitly enabled. Production must enable email delivery.
EMAIL_DELIVERY_ENABLED=false
# resend for deployment. local writes development-only messages to a private inbox.
EMAIL_TRANSPORT=resend
LOCAL_MAIL_DIR=.local/mail
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Database integration tests require a separate disposable PostgreSQL database.
TEST_DATABASE_URL=
POSTGRES_PASSWORD=
