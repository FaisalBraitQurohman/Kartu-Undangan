generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum UserRole {
  USER
  ADMIN
}
enum InvitationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
enum OrderStatus {
  CREATED
  PENDING
  PAID
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
  CHARGEBACK
}
enum RSVPStatus {
  ATTENDING
  NOT_ATTENDING
  MAYBE
}
enum MediaType {
  IMAGE
  AUDIO
}
enum TemplateCategory {
  WEDDING
  ENGAGEMENT
  CELEBRATION
}
model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String?
  role UserRole @default(USER)
  emailVerified DateTime?
  image String?
  sessionVersion Int @default(0)
  disabledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  accounts Account[]
  sessions Session[]
  templates UserTemplate[]
  invitations Invitation[]
  orders Order[]
  auditLogs AuditLog[]
  resetTokens PasswordResetToken[]
}
model Account {
  id String @id @default(cuid())
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String? @db.Text
  access_token String? @db.Text
  expires_at Int?
  token_type String?
  scope String?
  id_token String? @db.Text
  session_state String?
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@unique([provider,providerAccountId])
}
model Session {
  id String @id @default(cuid())
  sessionToken String @unique
  userId String
  expires DateTime
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}
model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@unique([identifier,token])
}
model PasswordResetToken {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId])
}
model Template {
  id String @id @default(cuid())
  key String @unique
  slug String @unique
  name String
  description String
  category TemplateCategory @default(WEDDING)
  price Int
  currency String @default("IDR")
  isFree Boolean @default(false)
  isActive Boolean @default(true)
  version Int @default(1)
  thumbnailUrl String
  previewImages String[]
  configSchema Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owners UserTemplate[]
  invitations Invitation[]
  purchases TemplatePurchase[]
  @@index([isActive,category])
}
model UserTemplate {
  id String @id @default(cuid())
  userId String
  templateId String
  purchasedAt DateTime @default(now())
  sourceOrderId String?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  template Template @relation(fields:[templateId],references:[id],onDelete:Restrict)
  sourceOrder Order? @relation(fields:[sourceOrderId],references:[id],onDelete:Restrict)
  @@unique([userId,templateId])
  @@index([sourceOrderId])
}
model Invitation {
  id String @id @default(cuid())
  userId String
  templateId String
  templateVersion Int @default(1)
  slug String @unique
  title String
  status InvitationStatus @default(DRAFT)
  content Json
  settings Json
  revision Int @default(0)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  template Template @relation(fields:[templateId],references:[id],onDelete:Restrict)
  events Event[]
  media Media[]
  guests Guest[]
  wishes Wish[]
  visits InvitationVisit[]
  @@index([userId,updatedAt])
  @@index([status,slug])
}
model Event {
  id String @id @default(cuid())
  invitationId String
  title String
  description String?
  startAt DateTime
  endAt DateTime?
  venue String
  address String
  latitude Decimal? @db.Decimal(9,6)
  longitude Decimal? @db.Decimal(9,6)
  sortOrder Int @default(0)
  invitation Invitation @relation(fields:[invitationId],references:[id],onDelete:Cascade)
  @@index([invitationId,sortOrder])
}
model Media {
  id String @id @default(cuid())
  invitationId String
  publicId String @unique
  url String
  type MediaType
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  deletingAt DateTime?
  bytes Int @default(0)
  invitation Invitation @relation(fields:[invitationId],references:[id],onDelete:Cascade)
  @@index([invitationId])
}
model Guest {
  id String @id @default(cuid())
  invitationId String
  name String
  phone String?
  token String @unique
  createdAt DateTime @default(now())
  invitation Invitation @relation(fields:[invitationId],references:[id],onDelete:Cascade)
  rsvp RSVP?
  wishes Wish[]
  @@index([invitationId,name])
}
model RSVP {
  id String @id @default(cuid())
  guestId String @unique
  status RSVPStatus
  attendeeCount Int
  message String?
  updatedAt DateTime @updatedAt
  guest Guest @relation(fields:[guestId],references:[id],onDelete:Cascade)
}
model Wish {
  id String @id @default(cuid())
  invitationId String
  guestId String?
  name String
  message String
  isApproved Boolean @default(false)
  createdAt DateTime @default(now())
  invitation Invitation @relation(fields:[invitationId],references:[id],onDelete:Cascade)
  guest Guest? @relation(fields:[guestId],references:[id],onDelete:SetNull)
  @@index([invitationId,isApproved,createdAt])
}
model Order {
  id String @id @default(cuid())
  userId String
  orderNumber String @unique
  totalAmount Int
  currency String @default("IDR")
  status OrderStatus @default(CREATED)
  provider String @default("MIDTRANS")
  providerReference String? @unique
  activePurchaseKey String? @unique
  snapToken String?
  redirectUrl String?
  createdAt DateTime @default(now())
  paidAt DateTime?
  confirmationSentAt DateTime?
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  purchases TemplatePurchase[]
  events PaymentEvent[]
  grants UserTemplate[]
  @@index([userId,createdAt])
  @@index([status])
}
model TemplatePurchase {
  id String @id @default(cuid())
  orderId String
  templateId String
  unitPrice Int
  createdAt DateTime @default(now())
  order Order @relation(fields:[orderId],references:[id],onDelete:Restrict)
  template Template @relation(fields:[templateId],references:[id],onDelete:Restrict)
  @@unique([orderId,templateId])
  @@index([templateId])
}
model PaymentEvent {
  id String @id @default(cuid())
  orderId String
  providerEventKey String @unique
  payload Json
  processedAt DateTime?
  createdAt DateTime @default(now())
  order Order @relation(fields:[orderId],references:[id],onDelete:Restrict)
  @@index([orderId,createdAt])
}
model InvitationVisit {
  id String @id @default(cuid())
  invitationId String
  visitedAt DateTime @default(now())
  invitation Invitation @relation(fields:[invitationId],references:[id],onDelete:Cascade)
  @@index([invitationId,visitedAt])
}
model AuditLog {
  id String @id @default(cuid())
  actorId String?
  action String
  entityType String
  entityId String
  metadata Json?
  createdAt DateTime @default(now())
  actor User? @relation(fields:[actorId],references:[id],onDelete:SetNull)
  @@index([createdAt])
  @@index([entityType,entityId])
}
model EmailJob {
  id String @id @default(cuid())
  key String @unique
  to String
  subject String
  text String
  attempts Int @default(0)
  lockedAt DateTime?
  sentAt DateTime?
  createdAt DateTime @default(now())
  @@index([sentAt,lockedAt])
}
